+/* Layer-shell surfaces follow workspaces without stealing keyboard focus.
+ * Drag the frame above the keys using either touch or a mouse. */
+static bool positioned = false, dragging = false;
+static int drag_touch_id = -1;
+static int position_x, position_y, drag_x, drag_y;
+
+static void
+move_keyboard(int x, int y)
+{
+    int max_x = (int)available_width - (int)keyboard.w;
+    int max_y = (int)available_height - (int)keyboard.h;
+    position_x = x < 0 ? 0 : (x > max_x ? max_x : x);
+    position_y = y < 0 ? 0 : (y > max_y ? max_y : y);
+    if (position_x < 0) position_x = 0;
+    if (position_y < 0) position_y = 0;
+    /* Keep input coordinates fixed while the compositor moves the existing
+     * keyboard buffer. No repaint and no moving-surface feedback. */
+    wl_subsurface_set_position(keyboard_subsurface, position_x, position_y);
+    struct wl_region *region = wl_compositor_create_region(compositor);
+    wl_region_add(region, position_x, position_y, keyboard.w, keyboard.h);
+    wl_surface_set_input_region(canvas.surf, region);
+    wl_region_destroy(region);
+    wl_surface_commit(canvas.surf);
+}
+
+static bool
+begin_drag(int x, int y, int id)
+{
+    if (!(margin || width_ratio) || y < 0 ||
+        y >= (int)(keyboard.border + keyboard.padding))
+        return false;
+    dragging = true;
+    drag_touch_id = id;
+    drag_x = x;
+    drag_y = y;
+    return true;
+}
